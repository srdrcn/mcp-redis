# Template for passwords.env, the source of the Secret "redis-mcp-passwords". Never commit real values.
#   oc create secret generic redis-mcp-passwords --from-env-file=passwords.env
# One line per cluster of redis-mcp.yaml: <cluster name>_pass=<password of the cluster's username>.
# The value is everything after the first "=": no quotes, no trailing spaces, no comment at the end of a line.
# A cluster without a password line connects without AUTH (the server logs a warning).
cbdevrds_pass=<password>
cbtstrds_pass=<password>
cbprdrds_pass=<password>
cbsbxrds_pass=<password>
# The commented sentinel cluster cbuatrds of the example config: the password of its Redis user, and the
# password of the Sentinels themselves (only if they require one)
# cbuatrds_pass=<password>
# cbuatrds_sentinel_pass=<password>
